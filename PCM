clc; 
clear all;
close all;

fs = 8000;	 
t = 0:1/fs:0.1;	
f = 100;
n = 4;	 
L = 2^n;	

x = sin(2*pi*f*t);

xq = round((x + 1) * (L-1) / 2);
xr = (xq * 2 / (L-1)) - 1;
noise = x - xr;
signal_power = mean(x.^2); 
noise_power = mean(noise.^2);

SNR_simulated = 10 * log10(signal_power / noise_power);

SNR_theoretical = 6.02*n + 1.76;

fprintf('Bit depth (n) = %d\n', n); 
fprintf('Simulated SNR = %.2f dB\n', SNR_simulated);
fprintf('Theoretical SNR = %.2f dB\n', SNR_theoretical);

figure;
subplot(3,1,1);
plot(t, x); 
title('Original Signal');
xlabel('Time'); 
ylabel('Amplitude');
grid on;

subplot(3,1,2);
stairs(t, xr);
title('Quantized / Reconstructed Signal');
xlabel('Time');
ylabel('Amplitude');
grid on;

subplot(3,1,3);
plot(t, noise);
title('Quantization Noise'); 
xlabel('Time'); 
ylabel('Amplitude'); 
grid on;

OUTPUT:-
Bit depth (n) = 4
Simulated SNR = 25.77 dB 
Theoretical SNR = 25.84 dB



