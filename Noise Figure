clc; 
clear; 
close all;

fs = 1000;		 
t = 0:1/fs:1-1/fs;	
f = 5;
A = 2;	

signal = A * sin(2*pi*f*t);

noise_amp = 0.5;
noise = noise_amp * randn(size(t));

signal_noisy = signal + noise;
signal_power = mean(signal.^2); 
noise_power = mean(noise.^2);

snr_val = 10 * log10(signal_power / noise_power);

snr_in_db = 20;	
snr_out_db = snr_val;
noise_figure = snr_in_db - snr_out_db;


fprintf('Calculated SNR = %.2f dB\n', snr_val); 
fprintf('Noise Figure = %.2f dB\n', noise_figure);

figure;
subplot(3,1,1);
plot(t, signal, 'LineWidth', 1.5);
title('Original Signal'); 
ylabel('Amplitude');
grid on;

subplot(3,1,2);
plot(t, noise, 'r'); 
title('White Gaussian Noise');
ylabel('Amplitude');
grid on;

subplot(3,1,3);
plot(t, signal_noisy, 'k');
title('Signal with Noise');
xlabel('Time (s)');
ylabel('Amplitude');
grid on;
 





